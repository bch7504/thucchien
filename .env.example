# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# LLM_PROVIDER selects which client get_llm() builds: "google" (default), "groq", or "openai".
LLM_PROVIDER=google
GOOGLE_API_KEY=AIzaSy-your-key-here
GROQ_API_KEY=
OPENAI_API_KEY=
MODEL_NAME=gemini-2.5-flash
# Groq example: LLM_PROVIDER=groq, MODEL_NAME=openai/gpt-oss-20b (reliable tool-calling; get a key at https://console.groq.com/keys)
# OpenAI example: LLM_PROVIDER=openai, MODEL_NAME=gpt-4o-mini (get a key at https://platform.openai.com/api-keys)
# Self-imposed daily token ceiling, purely for the usage warning on the Admin dashboard —
# not enforced by any provider, just an early-warning number you pick.
DAILY_TOKEN_BUDGET=200000

# ---- Database ----
# PostgreSQL only — required, no SQLite fallback. Also gives the LangGraph agent persistent
# conversation memory (AsyncPostgresSaver) that survives backend restarts.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- Auth ----
SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Email that gets the "admin" role automatically on registration (bootstrap the first admin) -
# applies to the first Google sign-in too, not just /auth/register.
INITIAL_ADMIN_EMAIL=

# ---- Auth — Google Sign-In ----
# "Sign in with Google" (ID-token verification only, no client secret) - unrelated to the "Google
# Calendar" section below, which is a separate, per-user OAuth Client (each user connects their
# OWN Calendar, not a shared account). Create a Web application OAuth Client ID (distinct from the
# Calendar section's Client) at https://console.cloud.google.com/apis/credentials, Authorized
# JavaScript origins: http://localhost:5173 for local dev. Must match Frontend/.env's
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Google Calendar (per-user) ----
# A SEPARATE Web application OAuth Client from GOOGLE_OAUTH_CLIENT_ID above - this one does a real
# authorization-code exchange (to get a refresh_token per user), so it needs a Client Secret too;
# the login one above never does and has none. Create it at
# https://console.cloud.google.com/apis/credentials:
#   - Enable "Google Calendar API" first (APIs & Services -> Library).
#   - OAuth consent screen: add scope https://www.googleapis.com/auth/calendar, add every test
#     user's email under "Test users" (sensitive scope -> app stays in Testing mode, max 100 test
#     users, and anyone not listed gets access_denied).
#   - Credentials -> Create Credentials -> OAuth client ID -> Web application.
#   - Authorized redirect URIs: must match GOOGLE_CALENDAR_REDIRECT_URI below EXACTLY (scheme,
#     host, port, trailing slash all matter) - this is a real server-side redirect, not a popup.
# Empty Client ID/Secret = GET /calendar/oauth/url returns 503, "Connect Google Calendar" shows an
# error instead of opening Google's consent screen.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh

# Fernet key encrypting each user's Calendar refresh_token at rest - generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER rotate once users have connected - every stored refresh_token becomes unreadable garbage
# and everyone has to reconnect. Empty = Calendar connect/use fails fast with a clear error
# instead of silently storing a plaintext secret.
CREDENTIAL_ENCRYPTION_KEY=

# Frontend origin - the OAuth callback page's postMessage back to the opener window is scoped to
# this origin only, so an unrelated page can't listen in on the "connected" signal.
FRONTEND_ORIGIN=http://localhost:5173
# How often (seconds) the backend polls Google Calendar for changes made outside the app (e.g.
# edited directly in Google Calendar) - real push notifications need a public HTTPS callback URL,
# which this project doesn't have without a real deployment, so this is the practical stand-in.
CALENDAR_POLL_INTERVAL_SECONDS=20

# ---- Reminders / Scheduler ----
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Logging ----
LOG_LEVEL=INFO
