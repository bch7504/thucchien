VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws
# "Sign in with Google" - same Web application OAuth Client ID as the backend's
# GOOGLE_OAUTH_CLIENT_ID (see root .env.example for how to create it). Empty disables the button.
VITE_GOOGLE_CLIENT_ID=
# "Connect Google Calendar" (on /calendar) needs no frontend env var - it's a backend-driven
# OAuth redirect (GET /calendar/oauth/url + a server-side callback), configured entirely via the
# backend's GOOGLE_CALENDAR_CLIENT_ID/SECRET/REDIRECT_URI (see root .env.example).
